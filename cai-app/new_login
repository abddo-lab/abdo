import { useEffect, useMemo, useState } from "react";
import { AnimatePresence, motion } from "framer-motion";
import { AlertTriangle, ArrowUpRight, Check, Copy } from "lucide-react";

const MONA_GIF = "https://github.githubassets.com/assets/mona-loading-dimmed-5da225352fd7.gif";
const BRAILLE = ["⠋", "⠙", "⠹", "⠸", "⠼", "⠴", "⠦", "⠧", "⠇", "⠏"];
const ALPHABET = "ABCDEFGHJKLMNPQRSTUVWXYZ23456789";
const EXPIRES_IN = 15 * 60;
const COMMAND = "kiren code";

function makeCode() {
  const pick = (n: number) =>
    Array.from({ length: n }, () => ALPHABET[Math.floor(Math.random() * ALPHABET.length)]).join("");
  return `${pick(4)}-${pick(4)}`;
}

const easeOut = [0.16, 1, 0.3, 1] as const;

/* ────────────────────────────── boot ────────────────────────────── */

function Boot({ onDone }: { onDone: () => void }) {
  const [typed, setTyped] = useState(0);
  const [showMona, setShowMona] = useState(false);
  const [progress, setProgress] = useState(0);
  const [checked, setChecked] = useState(false);

  useEffect(() => {
    const timers: number[] = [];
    for (let i = 1; i <= COMMAND.length; i++) {
      timers.push(window.setTimeout(() => setTyped(i), 260 + i * 62));
    }
    timers.push(window.setTimeout(() => setShowMona(true), 260 + COMMAND.length * 62 + 260));
    timers.push(window.setTimeout(() => setChecked(true), 2050));
    timers.push(window.setTimeout(onDone, 2950));
    return () => timers.forEach(window.clearTimeout);
  }, [onDone]);

  useEffect(() => {
    if (!showMona) return;
    let raf = 0;
    const start = performance.now();
    const tick = (now: number) => {
      const p = Math.min(1, (now - start) / 1500);
      setProgress(1 - Math.pow(1 - p, 3));
      if (p < 1) raf = requestAnimationFrame(tick);
    };
    raf = requestAnimationFrame(tick);
    return () => cancelAnimationFrame(raf);
  }, [showMona]);

  return (
    <motion.div
      key="boot"
      className="boot"
      exit={{ opacity: 0, y: -14 }}
      transition={{ duration: 0.35 }}
    >
      <p className="boot-prompt">
        <span className="sigil">›</span>
        {COMMAND.slice(0, typed)}
        <span className="caret-block" />
      </p>

      <div className="boot-center">
        <AnimatePresence>
          {showMona && (
            <motion.img
              key="mona"
              src={MONA_GIF}
              alt="Mona loading"
              className="boot-mona"
              initial={{ opacity: 0, scale: 0.82 }}
              animate={{ opacity: 1, scale: 1 }}
              transition={{ duration: 0.5, ease: easeOut }}
            />
          )}
        </AnimatePresence>
        {showMona && (
          <motion.div
            initial={{ opacity: 0, y: 8 }}
            animate={{ opacity: 1, y: 0 }}
            transition={{ delay: 0.15, duration: 0.4 }}
            className="flex flex-col items-center gap-4"
          >
            <p className="boot-label">
              Starting <b>kiren code</b> v1.0.26
            </p>
            <div className="boot-track">
              <div className="boot-fill" style={{ width: `${progress * 100}%` }} />
            </div>
            <AnimatePresence>
              {checked && (
                <motion.p
                  initial={{ opacity: 0, y: 6 }}
                  animate={{ opacity: 1, y: 0 }}
                  className="boot-check"
                >
                  <span className="tick">✓</span> github device flow ready
                </motion.p>
              )}
            </AnimatePresence>
          </motion.div>
        )}
      </div>
    </motion.div>
  );
}

/* ─────────────────────────── auth screen ────────────────────────── */

function useBraille() {
  const [frame, setFrame] = useState(0);
  useEffect(() => {
    const id = window.setInterval(() => setFrame((f) => (f + 1) % BRAILLE.length), 85);
    return () => window.clearInterval(id);
  }, []);
  return BRAILLE[frame];
}

function AuthScreen() {
  const code = useMemo(() => makeCode(), []);
  const [revealed, setRevealed] = useState(0);
  const [seconds, setSeconds] = useState(EXPIRES_IN);
  const [copied, setCopied] = useState(false);
  const spinner = useBraille();

  useEffect(() => {
    let revealId = 0;
    const start = window.setTimeout(() => {
      revealId = window.setInterval(
        () => setRevealed((r) => (r >= code.length ? r : r + 1)),
        75
      );
    }, 900);
    const countdown = window.setInterval(() => setSeconds((s) => Math.max(0, s - 1)), 1000);
    return () => {
      window.clearTimeout(start);
      window.clearInterval(revealId);
      window.clearInterval(countdown);
    };
  }, [code.length]);

  const copyCode = async () => {
    try {
      await navigator.clipboard.writeText(code);
    } catch {
      /* clipboard can be blocked in sandboxed previews */
    }
    setCopied(true);
    window.setTimeout(() => setCopied(false), 1500);
  };

  const mm = String(Math.floor(seconds / 60)).padStart(2, "0");
  const ss = String(seconds % 60).padStart(2, "0");

  return (
    <motion.div
      key="auth"
      className="flex flex-1 flex-col"
      initial={{ opacity: 0 }}
      animate={{ opacity: 1 }}
      transition={{ duration: 0.4 }}
    >
      {/* wordmark */}
      <motion.div
        initial={{ opacity: 0, y: 12 }}
        animate={{ opacity: 1, y: 0 }}
        transition={{ delay: 0.25, duration: 0.55, ease: easeOut }}
        className="mt-10 flex items-center gap-4"
      >
        <span className="sparkle" aria-hidden="true">✻</span>
        <h1 className="wordmark">kiren code</h1>
        <span className="ver-pill">v1.0.26</span>
      </motion.div>

      <motion.p
        initial={{ opacity: 0, y: 10 }}
        animate={{ opacity: 1, y: 0 }}
        transition={{ delay: 0.38, duration: 0.5 }}
        className="lede mt-4"
      >
        Welcome! To start a session, <b>authenticate with GitHub</b> using the device code below.
        Nothing runs until you approve it from your browser.
      </motion.p>

      {/* auth panel */}
      <motion.div
        initial={{ opacity: 0, y: 18 }}
        animate={{ opacity: 1, y: 0 }}
        transition={{ delay: 0.5, duration: 0.6, ease: easeOut }}
        className="panel"
      >
        <span className="panel-legend">
          <span className="legend-dot" />
          Authenticate with GitHub
        </span>

        {/* step 1 */}
        <motion.div
          initial={{ opacity: 0, x: -10 }}
          animate={{ opacity: 1, x: 0 }}
          transition={{ delay: 0.68, duration: 0.45 }}
          className="step"
        >
          <span className="step-num">1.</span>
          <div className="step-body">
            <p className="step-title">Open this link in your browser and sign in</p>
            <a className="url-chip" href="#device" onClick={(e) => e.preventDefault()}>
              https://github.com/login/device
              <ArrowUpRight className="arrow h-3.5 w-3.5" />
            </a>
          </div>
        </motion.div>

        {/* step 2 */}
        <motion.div
          initial={{ opacity: 0, x: -10 }}
          animate={{ opacity: 1, x: 0 }}
          transition={{ delay: 0.82, duration: 0.45 }}
          className="step"
        >
          <span className="step-num">2.</span>
          <div className="step-body">
            <p className="step-title">Enter this <b>one-time code</b></p>
            <div className="code-row" aria-label={`Device code ${code}`}>
              {code.split("").map((ch, i) => {
                if (ch === "-") return <span key={i} className="code-cell code-cell--hyphen">-</span>;
                const on = i < revealed;
                const active = i === revealed - 1;
                return (
                  <motion.span
                    key={i}
                    initial={{ opacity: 0, y: 10 }}
                    animate={{ opacity: on ? 1 : 0.22, y: 0 }}
                    transition={{ duration: 0.28, ease: easeOut }}
                    className={`code-cell ${on ? "code-cell--on" : ""} ${active ? "code-cell--active" : ""}`}
                  >
                    {on ? ch : "·"}
                  </motion.span>
                );
              })}
            </div>
            <div className="meta-row">
              <button onClick={copyCode} className={`chip-btn ${copied ? "is-done" : ""}`}>
                {copied ? <Check className="h-3.5 w-3.5" /> : <Copy className="h-3.5 w-3.5" />}
                {copied ? "copied" : "copy code"}
              </button>
              <span className="expires">
                expires in <b>{mm}:{ss}</b>
              </span>
            </div>
          </div>
        </motion.div>

        {/* warning */}
        <motion.div
          initial={{ opacity: 0 }}
          animate={{ opacity: 1 }}
          transition={{ delay: 1.5, duration: 0.45 }}
          className="warning"
        >
          <AlertTriangle className="h-3.5 w-3.5" />
          <span>Device codes are a common phishing target. Never share this code — only enter it on github.com.</span>
        </motion.div>
      </motion.div>

      {/* waiting line */}
      <motion.div
        initial={{ opacity: 0, y: 10 }}
        animate={{ opacity: 1, y: 0 }}
        transition={{ delay: 1.75, duration: 0.5 }}
        className="waiting"
      >
        <span className="spinner" aria-hidden="true">{spinner}</span>
        <span>Waiting for GitHub authorization — keep this window open</span>
        <img src={MONA_GIF} alt="" className="mona-mini" />
      </motion.div>

      {/* footer hints */}
      <motion.div
        initial={{ opacity: 0 }}
        animate={{ opacity: 1 }}
        transition={{ delay: 2.05, duration: 0.5 }}
        className="term-footer"
      >
        <div>
          <span className="hint"><span className="kbd">?</span> shortcuts</span>
          <span className="hint"><span className="kbd">esc</span> quit</span>
          <span className="hint"><span className="kbd">⌘C</span> copy code</span>
          <span className="hint"><span className="kbd">↵</span> re-send code</span>
        </div>
      </motion.div>
    </motion.div>
  );
}

/* ─────────────────────────────── app ────────────────────────────── */

export default function App() {
  const [stage, setStage] = useState<"boot" | "auth">("boot");

  return (
    <div className="relative min-h-screen">
      <div className="term-bg" aria-hidden="true" />
      <div className="term-column">
        <AnimatePresence mode="wait">
          {stage === "boot" ? (
            <Boot onDone={() => setStage("auth")} />
          ) : (
            <AuthScreen />
          )}
        </AnimatePresence>
      </div>
    </div>
  );
}
